import math


def minimax(depth, index, is_max, scores, target):
    """Returns (value, leaves_visited)."""
    if depth == target:
        return scores[index], 1

    best = float('-inf') if is_max else float('inf')
    leaves = 0
    for child in (index * 2, index * 2 + 1):
        val, count = minimax(depth + 1, child, not is_max, scores, target)
        leaves += count
        best = max(best, val) if is_max else min(best, val)
    return best, leaves


def alphabeta(depth, index, is_max, scores, target, alpha, beta):
    """Returns (value, leaves_visited)."""
    if depth == target:
        return scores[index], 1

    best = float('-inf') if is_max else float('inf')
    leaves = 0
    for child in (index * 2, index * 2 + 1):
        val, count = alphabeta(depth + 1, child, not is_max, scores, target, alpha, beta)
        leaves += count
        if is_max:
            best = max(best, val)
            alpha = max(alpha, best)
        else:
            best = min(best, val)
            beta = min(beta, best)
        if alpha >= beta:  # prune
            break
    return best, leaves


tests = [
    [3, 5, 2, 9, 3, 5, 2, 9],
    [5, 3, 9, 2, 5, 3, 9, 2],
    [2, 9, 3, 5, 2, 9, 3, 5],
    [4, 4, 4, 4, 4, 4, 4, 4],
]

for scores in tests:
    depth = int(math.log2(len(scores)))
    mm_val, mm_leaves = minimax(0, 0, True, scores, depth)
    ab_val, ab_leaves = alphabeta(0, 0, True, scores, depth,
                                  float('-inf'), float('inf'))
    print("Scores   :", scores)
    print(f"Minimax  : value={mm_val}, leaves={mm_leaves}")
    print(f"AlphaBeta: value={ab_val}, leaves={ab_leaves}")
    print() 